{
  "name": "my-kernit",
  "description": "My Kernit - Customer Debt Management App",
  "author": "Your Name",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "Electron/main.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "electron-build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.mykernit.app",
    "productName": "My Kernit",
    "files": [
      "dist-web/**/*",
      "Electron/**/*.cjs"
    ],
    "extraResources": [
      {
        "from": "dist-web",
        "to": "dist-web",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.25.0",
    "clsx": "^2.0.0",
    "dexie": "^4.0.4",
    "dexie-react-hooks": "^4.2.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "electron-is-dev": "^3.0.1",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "wait-on": "^9.0.4"
  }
}
